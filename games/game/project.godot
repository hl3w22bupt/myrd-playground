; Engine configuration file.
; 《糖果粉碎传奇》（Candy Crush Legend）—— 休闲收集（三消）工程。
; 三类必接线：主场景（run/main_scene）、自动加载单例（[autoload]）、输入映射（[input]）。
; 任何一项缺失都会让游戏「黑屏 / 无响应」，因此它们也是 scripts/preflight.py 的静态检查对象。

config_version=5

[application]

config/name="糖果粉碎传奇"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/game_state.gd"
GameAudio="*res://autoload/audio_manager.gd"
SaveState="*res://autoload/save_state.gd"

[display]

; 竖屏设计分辨率（窄屏手机为主力目标）；stretch aspect=expand：窗口比设计更高/更宽时
; 视口向外扩展（不裁切不留黑边），棋盘由 main.gd _layout() 居中重排，HUD/按钮锚定四边。
window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 手持设备锁定竖屏（iOS/Android 导出与部分移动浏览器遵循）。
window/handheld/orientation="portrait"

