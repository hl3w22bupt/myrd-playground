# Godot 本机导入缓存：由 `godot --headless --path . --import` 重新生成，不进版本库
.godot/

# 导出产物：桌面端产物不入库；export/web 是 AppHost 部署的构建输入，必须入库
/export/*
!/export/web/
# 自定义导出壳：export_presets.cfg 的 html/custom_html_shell 指向它（页面标题《hello》），
# 是重导出的构建输入，必须随仓库走，否则换工作区导出必失败
!/export/web-shell.html
*.exe
*.zip

# 系统
.DS_Store
