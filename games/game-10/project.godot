; Engine configuration file.
; 《节奏大师》—— 四轨下落式音乐节拍游戏（休闲收集）。
; 三类必接线：主场景（run/main_scene）、自动加载单例（[autoload]）、输入映射（[input]）。
; 任何一项缺失都会让游戏「黑屏 / 无响应」，因此它们也是 scripts/preflight.py 的静态检查对象。

config_version=5

[application]

config/name="节奏大师，音乐节拍类游戏"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/game_state.gd"
Juice="*res://autoload/juice.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

; 全局默认字体：子集化 Noto Sans CJK SC（GB2312 全集 + ASCII + 常用符号，见 assets/fonts/OFL.txt）。
; Web 导出运行在浏览器沙箱里拿不到系统字体，引擎内置默认字体只含拉丁字形；
; 没有这份字体，工程里所有中文（Label 文本、draw_string、对话框）都会渲染成缺字方块。
theme/custom_font="res://assets/fonts/NotoSansSC-Regular.otf"

[input]

; 四轨击打键（桌面端；移动端为屏幕下方四个触控分区，见 main.gd TouchUI）。
lane_1={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":68,"key_label":0,"unicode":100,"location":0,"echo":false,"script":null)
]
}
