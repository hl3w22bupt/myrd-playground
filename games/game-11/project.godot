[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
; 画质 v2（专项二：画面精美）：MSAA 3D 2×。兼容渲染器通过多重采样帧缓冲实现，
; 模型边缘无锯齿楼梯。选 2× 不选 4×：hidpi 3x DPR 背板已达 1170×2532，2× MSAA 在
; 移动 GPU 上的边际成本可控（弱设备还有 main.gd 的质量看门狗兜底降档）。
anti_aliasing/quality/msaa_3d=1
