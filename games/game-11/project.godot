; Engine configuration file.
; Godot 4.x 最小可运行工程骨架（2D）。
; 本文件演示三类必接线：主场景（run/main_scene）、自动加载单例（[autoload]）、输入映射（[input]）。
; 任何一项缺失都会让游戏「黑屏 / 无响应」，因此它们也是 scripts/preflight.py 的静态检查对象。

config_version=5

[application]

config/name="做一个线上抓娃娃游戏，支持多种夹爪，多种娃娃。夹爪和娃娃的美"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/game_state.gd"
Juice="*res://autoload/juice.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
; 画质 v2（专项一：字体清晰）：canvas 按 devicePixelRatio 渲染。Web 端 hidpi 开启后，
; iPhone 390×844@3x 的背板是 1170×2532，配合 stretch mode=canvas_items（矢量重排）+
; aspect=expand（任意窗口占比铺满、无黑边），字体按最终分辨率光栅化而不是位图拉伸。
window/dpi/allow_hidpi=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="portrait"

[gui]

; 全局默认字体：子集化 Noto Sans CJK SC（GB2312 全集 + ASCII + 常用符号，见 assets/fonts/OFL.txt）。
; Web 导出运行在浏览器沙箱里拿不到系统字体，引擎内置默认字体只含拉丁字形；
; 没有这份字体，工程里所有中文（Label 文本、draw_string、对话框）都会渲染成缺字方块。
theme/custom_font="res://assets/fonts/NotoSansSC-Regular.otf"

