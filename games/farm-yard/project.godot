; Engine configuration file.
; 《田园小院》—— 田园风模拟经营（种植 → 养殖 → 加工 → 出售 → 扩建）。
; 三类必接线：主场景（run/main_scene）、自动加载单例（[autoload]）、输入映射（[input]）。
; 任何一项缺失都会让游戏「黑屏 / 无响应」，因此它们也是 std-skills preflight.py 的静态检查对象。
;
; 玩法为纯点按交互（点作物收获 / 点空地弹种植菜单 / 点按钮买卖建造）：
; - 桌面 = 鼠标点击；移动端 = 触摸（引擎默认 emulate_mouse_from_touch 把触摸投递为鼠标事件，
;   点击语义天然一致，见 scripts/yard_view.gd 的 _unhandled_input）；
; - 键盘提供等价动作：confirm（空格/回车）= 收获全部成熟物，toggle_mute（M）= 静音开关。

config_version=5

[application]

config/name="田园小院"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://icon.svg"

[autoload]

FarmData="*res://autoload/farm_data.gd"
GameState="*res://autoload/game_state.gd"
Juice="*res://autoload/juice.gd"

[display]

; 竖屏设计分辨率（窄屏手机为主力目标）；stretch aspect=expand：窗口比设计更高/更宽时
; 视口向外扩展（不裁切不留黑边），庭院五区由 yard_view.gd 按视口实际高度纵向排布。
window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; 手持设备锁定竖屏（iOS/Android 导出与部分移动浏览器遵循）。
window/handheld/orientation="portrait"

[gui]

; 全局默认字体：子集化 Noto Sans CJK SC（GB2312 全集 + ASCII + 常用符号，见 assets/fonts/OFL.txt）。
; Web 导出运行在浏览器沙箱里拿不到系统字体，引擎内置默认字体只含拉丁字形；
; 没有这份字体，工程里所有中文（Label 文本、draw_string、对话框）都会渲染成缺字方块。
theme/custom_font="res://assets/fonts/NotoSansSC-Regular.otf"

[input]

confirm={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194309,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":32,"key_label":0,"unicode":32,"location":0,"echo":false,"script":null)
]
}
toggle_mute={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":77,"key_label":0,"unicode":109,"location":0,"echo":false,"script":null)
]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
