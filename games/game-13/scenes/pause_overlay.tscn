[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/pause_overlay.gd" id="1_script"]

[node name="PauseOverlay" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.03, 0.06, 0.72)

[node name="Card" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -80.0
offset_right = 200.0
offset_bottom = 80.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Card"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
horizontal_alignment = 1
text = "暂停中"

[node name="Status" type="Label" parent="Card"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
horizontal_alignment = 1
text = "本轮进度已保存"
autowrap_mode = 2

[node name="Buttons" type="HBoxContainer" parent="Card"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 18

[node name="ResumeButton" type="Button" parent="Card/Buttons"]
layout_mode = 2
text = "继续 (ESC)"

[node name="QuitButton" type="Button" parent="Card/Buttons"]
layout_mode = 2
text = "存档并退出"

[connection signal="pressed" from="Card/Buttons/ResumeButton" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="Card/Buttons/QuitButton" to="." method="_on_quit_pressed"]
