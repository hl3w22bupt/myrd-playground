        {
          "id": "rest",
          "text": "靠着墙闭眼一会儿。",
          "effects": { "stamina": 40 },
          "goto": "ARENA"
        }
      ]
    },
    {
      "id": "act3.n07",
      "type": "narration",
      "phase": "post_arena",
      "text": "倒计时归零。公寓门被数据流封死。五位女友站在你面前——包围了一整场的她们，此刻安静得像五封没寄出的信，等你最后一句话。"
    , "goto": "act3.c04"
    },
    {
      "id": "act3.c04",
      "type": "choice",
      "prompt": "最后一句话，决定所有人的结局。",
      "options": [
        {
          "id": "run",
          "text": "「对不起——让我一个人活下去。」",
          "ending_intent": "alone",
          "goto": "RESOLVE"
        },
        {
          "id": "save_one",
          "text": "「带走一个：跟我关系最深的那个人。」",
          "ending_intent": "save_one",
          "goto": "RESOLVE"
        },
        {
          "id": "upload",
          "text": "「一起上传：数据世界里，谁也不许掉队。」",
          "ending_intent": "together",
          "goto": "RESOLVE"
        }
      ]
