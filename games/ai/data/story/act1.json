        "position": [110, 80],
        "line": "小主人～热可可趁热喝哦，今天先从治愈你开始～"
      },
      {
        "node_id": "act1.t2",
        "persona_id": "momo",
        "position": [540, 230],
        "line": "互动互动！家人们，这就是心动的感觉，镜头给到！"
      }
    ],
    "hazards": [
      {
        "node_id": "act1.h1",
