node_modules
dist
# 例外：games/myrdplaygrou-3/dist 是 AppHost 部署产物（threejs 线构建落位，任务指定路径），
# 必须入库供平台资产通道上传 —— 其余层级 dist（vite 等构建中间物）仍照旧忽略
!games/myrdplaygrou-3/dist
coverage
*.local
.DS_Store
.gstack/
.myrd-platform/

# 判定脚本运行期暂存目录（playtest.sh / input-fuzz.sh 现场生成、退出即删；入库 = 污染 pck）
tests/.playtest/
tests/.fuzz/
# mobile-web-smoke 判定脚本的运行期输出（报告 + 分阶段截图落 scripts/qa/mobile/）；
# 证据一律随 games/<game>/qa/ 归档入库，判定脚本自身目录不留运行产物
std-skills/godot-game-dev/scripts/qa/
